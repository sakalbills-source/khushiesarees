# ----------------------------------------------------------------------------
# Khushie Sarees environment variables (copy to .env.local, or set in Vercel)
# Products, copy and photos live in lib/catalog.ts; these are only keys/links.
# ----------------------------------------------------------------------------

# Stripe TEST keys (https://dashboard.stripe.com/test/apikeys). Live keys are
# refused automatically on anything except a production deployment.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Signing secret of the webhook endpoint <site>/api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase (optional but recommended): stock + paid orders.
# Run supabase/schema.sql, supabase/orders_fx.sql, supabase/khushie_inventory.sql.
# Without Supabase, stock is counted from paid Stripe Checkout Sessions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Owner-supplied links. Leave EMPTY until confirmed: empty = placeholder shown.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Draft banner shows on every non-production deployment; set to "off" to hide.
NEXT_PUBLIC_DRAFT_BANNER=

# Public base URL. Leave empty on Vercel previews (VERCEL_URL is used).
NEXT_PUBLIC_SITE_URL=

# Admin panel password (legacy /admin/products screen).
ADMIN_PASSWORD=

# Local development only: keep stock in .data/inventory.json
# INVENTORY_BACKEND=file
